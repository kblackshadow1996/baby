/* app.wxss —— 全局样式：清新可爱风设计系统 */
page {
  /* ===== 色板 ===== */
  --color-primary: #FF8FA3;       /* 主粉 */
  --color-pink-soft: #FFE4E1;     /* 柔粉 */
  --color-blue-soft: #E0F0FF;     /* 柔蓝 */
  --color-green-soft: #E8F5E9;    /* 柔绿 */
  --color-yellow-soft: #FFF8E1;   /* 柔黄 */
  --color-bg: #FFF8F6;            /* 页面背景 */
  --color-card: #FFFFFF;          /* 卡片底色 */
  --color-text: #4A4A4A;          /* 主文字 */
  --color-text-sub: #9B9B9B;      /* 次级文字 */
  --color-warning: #FF6B6B;       /* 警示 */
  --color-warning-bg: #FFF0F0;    /* 警示背景 */
  /* ===== 圆角 / 阴影 ===== */
  --radius-card: 24rpx;
  --radius-btn: 999rpx;
  --shadow-card: 0 8rpx 24rpx rgba(255, 143, 163, 0.12);
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
/* ===== 全局盒模型 ===== */
view,
text,
button,
input,
textarea,
image,
scroll-view,
navigator {
  box-sizing: border-box;
}
/* ===== 卡片 ===== */
.card {
  background-color: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  /* Task18：卡片统一过渡（点击态/悬浮态更顺滑，不改 padding/圆角/阴影本身） */
  transition: transform .15s ease, box-shadow .15s ease;
}
/* ===== 布局 ===== */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
/* ===== 文字 ===== */
.text-sub {
  color: var(--color-text-sub);
  font-size: 24rpx;
}
/* ===== 彩色胶囊标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-btn);
  font-size: 22rpx;
  line-height: 1.4;
  background-color: var(--color-pink-soft);
  color: var(--color-primary);
}
.tag-blue {
  background-color: var(--color-blue-soft);
  color: #5B9BD5;
}
.tag-green {
  background-color: var(--color-green-soft);
  color: #66BB6A;
}
.tag-yellow {
  background-color: var(--color-yellow-soft);
  color: #D4A017;
}
.tag-warning {
  background-color: var(--color-warning-bg);
  color: var(--color-warning);
}
/* ===== 按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  border: none;
  line-height: 1.4;
  /* Task18：补按压态过渡 */
  transition: transform .15s ease, opacity .15s ease;
}
.btn-primary::after {
  border: none;
}
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-btn);
  padding: 18rpx 46rpx;
  font-size: 30rpx;
  line-height: 1.4;
  /* Task18：补按压态过渡 */
  transition: transform .15s ease, opacity .15s ease;
}
.btn-ghost::after {
  border: none;
}
/* ===== 底部安全区 ===== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========================================================================== */
/* Task18：全局动效与交互反馈（以下均为新增，不覆盖上方已有类）                  */
/* ========================================================================== */

/* 可点击态：页面给可点卡片/条目加 class="tappable"，即获得轻微按压反馈 */
.tappable {
  transition: transform .15s ease, opacity .15s ease;
}
.tappable:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 按钮按压态 */
.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}
.btn-ghost:active {
  opacity: 0.85;
}

/* 通用淡入上移动画：供列表/卡片入场使用（可选） */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.fade-in {
  animation: fadeInUp .3s ease both;
}

/* 主粉实心白字胶囊（备用） */
.tag-primary-solid {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-btn);
  font-size: 22rpx;
  line-height: 1.4;
  background-color: var(--color-primary);
  color: #FFFFFF;
}

/* 统一禁用态 */
.is-disabled {
  opacity: 0.5;
}

/* ===== 字体层级工具类（统一层级，供各页按需替换硬编码字号；仅新增不强制） ===== */
.t-title {
  font-size: 36rpx;
  font-weight: 700;
}
.t-subtitle {
  font-size: 30rpx;
  font-weight: 600;
}
.t-body {
  font-size: 28rpx;
  font-weight: 400;
}
.t-caption {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-text-sub);
}

/* ===== 深色模式基础：仅覆盖 CSS 变量，不逐页改样式，保守保证可读性 ===== */
@media (prefers-color-scheme: dark) {
  page {
    --color-bg: #1C1A1B;          /* 页面背景（深） */
    --color-card: #2A2728;        /* 卡片底色（深灰） */
    --color-text: #ECECEC;        /* 主文字（浅） */
    --color-text-sub: #A0999B;    /* 次级文字（中灰） */
    /* --color-primary 保持主粉不变，维持品牌一致 */
    --color-pink-soft: #3A2E30;   /* 柔粉底（深化，避免浅底过亮） */
    --color-blue-soft: #263038;
    --color-green-soft: #26322A;
    --color-yellow-soft: #33301F;
    --color-warning-bg: #3A2626;  /* 警示背景（深化） */
    --shadow-card: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  }
}
