/* components/empty-state/empty-state.wxss —— 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
}
.empty-state__icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  /* Task18：轻微上下浮动，让空状态更有生气 */
  animation: emptyFloat 2.4s ease-in-out infinite;
}
.empty-state__text {
  font-size: 28rpx;
  color: var(--color-text-sub, #9B9B9B);
  text-align: center;
  line-height: 1.6;
}
@keyframes emptyFloat {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
  100% {
    transform: translateY(0);
  }
}
