/* pages/allergy/detail/detail.wxss —— 过敏记录新增 / 详情 */
.page {
  padding: 24rpx 24rpx 180rpx;
}
.loading-tip {
  padding: 48rpx 0;
  text-align: center;
}

/* ===== 表单区块 ===== */
.form-block {
  margin-bottom: 24rpx;
}
.form-block__label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.form-block__req {
  color: var(--color-warning);
  margin-left: 6rpx;
}
.form-block__optional {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-sub);
}
.form-block__hint {
  margin-bottom: 16rpx;
}
.date-text {
  font-size: 30rpx;
  color: var(--color-text);
}

/* ===== 多选胶囊 ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-btn);
  font-size: 26rpx;
  line-height: 1.3;
  background-color: #F5F5F5;
  color: var(--color-text-sub);
  border: 2rpx solid transparent;
}
/* 选中态：淡红不惊悚 */
.chip--on {
  background-color: var(--color-warning-bg);
  color: var(--color-warning);
  border-color: var(--color-warning);
}
/* 过敏原候选选中用柔黄区分于症状 */
.chip--food.chip--on {
  background-color: var(--color-yellow-soft);
  color: #D4A017;
  border-color: #E8C35B;
}
/* 严重程度选中态按级别着色 */
.chip--sev.chip--on.chip--sev-mild {
  background-color: #FFF4E6;
  color: #E59A3A;
  border-color: #F0C089;
}
.chip--sev.chip--on.chip--sev-moderate {
  background-color: #FFECEC;
  color: #E86A6A;
  border-color: #F3A6A6;
}
.chip--sev.chip--on.chip--sev-severe {
  background-color: #FBE3E3;
  color: #D64545;
  border-color: #E79090;
}

/* ===== 输入框 / 文本域 ===== */
.field-input {
  margin-top: 16rpx;
  width: 100%;
  padding: 18rpx 24rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
}
.field-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 24rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ===== 操作区 ===== */
.actions {
  margin-top: 16rpx;
  padding: 0 8rpx;
}
.actions .btn-primary {
  width: 100%;
}

/* ===== view 模式 ===== */
.view-block {
  margin-bottom: 24rpx;
}
.view-block__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
.view-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.view-row__label {
  font-size: 26rpx;
  color: var(--color-text-sub);
}
.view-row__value {
  font-size: 28rpx;
  color: var(--color-text);
}
.view-tag {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
}
.view-note {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.7;
}
