/* pages/baby/manage/manage.wxss —— 宝贝管理 */
.page {
  padding: 24rpx;
}

.manage__list {
  display: flex;
  flex-direction: column;
}

.manage__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
  transition: border-color 0.2s ease;
}
.manage__item--active {
  border-color: var(--color-primary, #FF8FA3);
}

.manage__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--color-pink-soft, #FFE4E1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.manage__avatar-img {
  width: 100%;
  height: 100%;
}
.manage__avatar-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.manage__info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.manage__name-row {
  align-items: center;
}
.manage__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text, #4A4A4A);
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.manage__check {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--color-primary, #FF8FA3);
  font-weight: 700;
}
.manage__age {
  margin-top: 6rpx;
}

.manage__edit {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-btn, 999rpx);
  background-color: var(--color-blue-soft, #E0F0FF);
}
.manage__edit-text {
  font-size: 24rpx;
  color: #5B9BD5;
}

.manage__add {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.manage__empty-action {
  margin-top: 8rpx;
  display: flex;
  justify-content: center;
}
