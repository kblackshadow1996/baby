/* pages/baby/profile/profile.wxss —— 宝贝档案 */
.page {
  padding: 24rpx;
}

/* 头像 */
.profile__avatar-wrap {
  display: flex;
  justify-content: center;
  margin: 16rpx 0 32rpx;
}
.profile__avatar {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--color-pink-soft, #FFE4E1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(255, 143, 163, 0.12));
}
.profile__avatar-img {
  width: 100%;
  height: 100%;
}
.profile__avatar-emoji {
  font-size: 80rpx;
  line-height: 1;
}
.profile__avatar-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 143, 163, 0.85);
  padding: 8rpx 0;
  display: flex;
  justify-content: center;
}
.profile__avatar-badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
}

/* 表单 */
.profile__form {
  margin-bottom: 20rpx;
}
.profile__field {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F3EDED;
}
.profile__field:last-child {
  border-bottom: none;
}
.profile__field--col {
  flex-direction: row;
  align-items: center;
}
.profile__label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text, #4A4A4A);
  font-weight: 600;
}
.profile__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text, #4A4A4A);
}
.profile__placeholder {
  color: var(--color-text-sub, #9B9B9B);
}
.profile__picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text, #4A4A4A);
}
.profile__picker--empty {
  color: var(--color-text-sub, #9B9B9B);
}

/* 性别单选 */
.profile__gender {
  flex: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.profile__gender-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}
.profile__gender-label {
  font-size: 28rpx;
  color: var(--color-text, #4A4A4A);
  margin-left: 4rpx;
}

/* 月龄预览 */
.profile__preview {
  margin-bottom: 24rpx;
}
.profile__preview-row {
  padding: 12rpx 0;
}
.profile__preview-key {
  font-size: 26rpx;
}
.profile__preview-val {
  font-size: 28rpx;
  color: var(--color-text, #4A4A4A);
  font-weight: 600;
}
.profile__preview-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 操作区 */
.profile__actions {
  margin-top: 16rpx;
}
.profile__save {
  width: 100%;
}
.profile__delete {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}
.profile__delete-text {
  font-size: 28rpx;
  color: var(--color-warning, #FF6B6B);
}
