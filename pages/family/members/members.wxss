/* pages/family/members/members.wxss —— 家庭成员 */
.page {
  padding: 24rpx;
}
.center-action {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

/* ===== 顶部宝贝 + 邀请 ===== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.head__baby {
  display: flex;
  align-items: center;
}
.head__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.head__avatar--emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background-color: var(--color-pink-soft, #FFE4E1);
}
.head__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #4A4A4A);
}
.head__count {
  font-size: 24rpx;
  color: var(--color-text-sub, #9B9B9B);
  margin-top: 4rpx;
}
.head__invite {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}

/* ===== 成员列表 ===== */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.member {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.member__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.member__avatar--emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background-color: var(--color-blue-soft, #E0F0FF);
}
.member__main {
  flex: 1;
  min-width: 0;
}
.member__line {
  display: flex;
  align-items: center;
}
.member__name {
  font-size: 30rpx;
  color: var(--color-text, #4A4A4A);
  font-weight: 500;
}
.member__me {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--color-primary, #FF8FA3);
  background-color: var(--color-pink-soft, #FFE4E1);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.member__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.member__remove {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--color-warning, #FF6B6B);
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--color-warning, #FF6B6B);
  border-radius: 999rpx;
}

/* ===== 只有自己 / 提示 ===== */
.only-self {
  margin-top: 32rpx;
}
.manage-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-sub, #9B9B9B);
}
